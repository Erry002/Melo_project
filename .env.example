# Example environment configuration for Melo Chat
# Copia questo file in `.env` e personalizza i valori locali.

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_PATH=./database/melo_chat.db

# JWT Configuration
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Voice Chat Configuration
VOICE_SAMPLE_RATE=44100
VOICE_BUFFER_SIZE=3
VOICE_CHUNK_SIZE=1024

# Ngrok Configuration (development)
NGROK_AUTHTOKEN=
NGROK_REGION=eu

# Raspberry Pi Specific
RPI_OPTIMIZE_MEMORY=true
RPI_LOW_POWER_MODE=false
RPI_AUDIO_DEVICE=hw:0,0

# Security Settings
CORS_ORIGIN=*
HELMET_ENABLED=true
SESSION_SECURE=false

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_COUNT=7

# Logging
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/app.log

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@melochat.local
FROM_NAME=Melo Chat

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@melo.local
ADMIN_PASSWORD=

# Performance Tuning
MAX_CONCURRENT_CONNECTIONS=100
SOCKET_IO_PING_TIMEOUT=60000
SOCKET_IO_PING_INTERVAL=25000
